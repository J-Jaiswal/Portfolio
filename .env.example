# Environment variables for the portfolio.
# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored; never commit real secrets.

# ── Formspree contact form ───────────────────────────────────────────────
# Get your endpoint at https://formspree.io (free tier is fine).
# If this variable is empty or unset, the form is hidden — only
# the email and social buttons are shown in the Contact section.
VITE_FORMSPREE_URL=
